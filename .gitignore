# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files. The trailing `*` also matches `.env.example`, which must be
# committed - it is the template documenting which vars exist. Negate it
# explicitly below, or the setup instructions in the README have no template
# to point at.
.env*
!.env.example

# firebase CLI - debug logs can contain auth tokens
firebase-debug.log
firestore-debug.log
ui-debug.log
.firebase/

# vercel
.vercel

# wrangler (created by the deploy workflow / local CLI runs)
.wrangler
.dev.vars

# typescript
*.tsbuildinfo
next-env.d.ts
